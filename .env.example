# ---- Required ----
# MongoDB Atlas connection string (database name included)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/aura_exteriors?retryWrites=true&w=majority"

# Public site URL (used for sitemap, Open Graph, email links). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://aura-exteriors.com"

# Initial admin account. Created automatically on first login attempt ONLY if no admin exists yet.
# Use a strong password (12+ chars). Change/remove after first login if desired.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# ---- Optional: email notifications (SMTP) ----
# If these are not set, submissions are still saved and shown in the Admin Portal; no email is claimed as sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Sender address, e.g. "Aura Exteriors <no-reply@aura-exteriors.com>"
SMTP_FROM=""
# Where admin notifications go (falls back to the contact email in Website Settings)
ADMIN_NOTIFY_EMAIL=""
